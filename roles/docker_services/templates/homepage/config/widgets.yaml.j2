---
- greeting:
    text_size: 3xl
    text: Eastie Home Lab

- logo:
    icon: https://benprisby.com/icon.svg

- resources:
    cpu: true
    memory: true
    disk: /
    cputemp: true
    tempmin: 0
    tempmax: 100
    uptime: true

- datetime:
    text_size: md
    format:
      dateStyle: full
      timeStyle: short
      hour12: true

- openweathermap:
    latitude: {{ vault_openweathermap_latitude }}
    longitude: {{ vault_openweathermap_longitude }}
    units: imperial
    provider: openweathermap
    apiKey: {{ vault_openweathermap_api_key }}
    cache: 5
    format:
      maximumFractionDigits: 1

- search:
    provider: google
    showSearchSuggestions: true
    target: _blank
